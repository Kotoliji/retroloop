generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Retro {
  /// Short random id that goes into the share link.
  id           String        @id
  title        String
  createdAt    DateTime      @default(now())
  participants Participant[]
  cards        Card[]
}

/// Someone who joined a retro by link. There are no accounts: the browser keeps
/// a secret token and the server stores only its hash.
model Participant {
  id        String   @id @default(uuid())
  retroId   String
  retro     Retro    @relation(fields: [retroId], references: [id], onDelete: Cascade)
  name      String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  cards     Card[]

  @@index([retroId])
}

model Card {
  /// Generated by the client, so a resent "add" after a reconnect is recognised
  /// instead of creating a duplicate.
  id        String      @id @db.Uuid
  retroId   String
  retro     Retro       @relation(fields: [retroId], references: [id], onDelete: Cascade)
  columnId  String
  text      String
  authorId  String
  author    Participant @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([retroId])
}
