generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Grows into the full retro model (columns, cards, votes, action items)
// in the next phase.
model Board {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
}
