generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A team's retros form a series: action items agreed in one retro are
/// reviewed at the start of the next.
model Team {
  id        String       @id
  name      String
  createdAt DateTime     @default(now())
  retros    Retro[]
  actions   ActionItem[]
}

model Retro {
  /// Short random id that goes into the share link.
  id             String        @id
  teamId         String
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// 1 for the team's first retro, then 2, 3, ...
  number         Int           @default(1)
  /// Retro format, see TEMPLATES in the shared package.
  template       String        @default("classic")
  title          String
  createdAt      DateTime      @default(now())
  /// review | write | group | vote | discuss | done
  stage          String        @default("write")
  hasReview      Boolean       @default(false)
  nextRetroId    String?
  /// Hash of the key given to whoever created the retro.
  hostKeyHash    String?
  facilitatorId  String?
  votesPerPerson Int           @default(3)
  timerEndsAt    DateTime?
  focusCardId    String?
  participants   Participant[]
  cards          Card[]
  votes          Vote[]
  actions        ActionItem[]
  surveys        SurveyResponse[]

  @@unique([teamId, number])
}

/// Someone who joined a retro by link. There are no accounts: the browser keeps
/// a secret token and the server stores only its hash.
model Participant {
  id        String   @id @default(uuid())
  retroId   String
  retro     Retro    @relation(fields: [retroId], references: [id], onDelete: Cascade)
  name      String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  cards     Card[]
  votes     Vote[]
  survey    SurveyResponse?

  @@index([retroId])
}

model Card {
  /// Generated by the client, so a resent "add" after a reconnect is recognised
  /// instead of creating a duplicate.
  id        String      @id @db.Uuid
  retroId   String
  retro     Retro       @relation(fields: [retroId], references: [id], onDelete: Cascade)
  columnId  String
  text      String
  authorId  String
  author    Participant @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// The top-level card this one is grouped under. Groups are one level deep.
  groupId   String?     @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  votes     Vote[]

  @@index([retroId])
}

/// One vote; a participant may put several of their votes on the same card.
model Vote {
  id            String      @id @default(uuid())
  retroId       String
  retro         Retro       @relation(fields: [retroId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  cardId        String      @db.Uuid
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([retroId])
  @@index([participantId])
}

/// Something the team agreed to do, owned by one person and due on a date.
model ActionItem {
  /// Generated by the client, like card ids, so a resent add is not stored twice.
  id                String    @id @db.Uuid
  teamId            String
  team              Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// The retro where the item was agreed.
  retroId           String
  retro             Retro     @relation(fields: [retroId], references: [id], onDelete: Cascade)
  sourceCardId      String?   @db.Uuid
  text              String
  ownerName         String
  dueDate           DateTime  @db.Date
  /// open | done | dropped
  status            String    @default("open")
  /// The retro whose review last changed this item, so it stays visible there.
  reviewedInRetroId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([teamId, status])
  @@index([retroId])
}

/// "How useful was this retro?" — one answer per participant, editable.
model SurveyResponse {
  id            String      @id @default(uuid())
  retroId       String
  retro         Retro       @relation(fields: [retroId], references: [id], onDelete: Cascade)
  participantId String      @unique
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /// 1 (not useful) to 5 (very useful)
  rating        Int
  comment       String?
  /// The participant agreed that the comment may be quoted, without their name.
  quotable      Boolean     @default(false)
  locale        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([retroId])
}

/// Anonymous product analytics: what happened, never who did it. No names,
/// card text, IP addresses or user agents are stored.
model ProductEvent {
  id        String   @id @default(uuid())
  name      String
  teamId    String?
  retroId   String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
