# Copy to .env.prod on the server and fill in. Never commit .env.prod.

# Host names Caddy serves (it gets HTTPS certificates for them).
WEB_ADDRESS=retroloop.example.com
API_ADDRESS=api.retroloop.example.com

# The same, as full URLs the browser uses.
WEB_URL=https://retroloop.example.com
API_URL=https://api.retroloop.example.com

# A long random password, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=

# Shown on the privacy page as the contact for data requests.
CONTACT_EMAIL=
