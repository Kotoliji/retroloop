# Realtime server
PORT=4000
DATABASE_URL=postgresql://retro:retro@127.0.0.1:5433/retro
REDIS_URL=redis://127.0.0.1:6380
WEB_ORIGIN=http://localhost:3001
# Enables the stats page (/en/admin) for whoever has it; 24+ characters
ADMIN_TOKEN=
# Teams created per minute from one address (10 in production; tests create many)
CREATE_LIMIT_PER_MINUTE=100
# E-mail reminders; in development they go to Mailpit (http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=Retroloop <reminders@localhost>

# Web app (exposed to the browser)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
# Shown on the privacy page as the contact for data requests
NEXT_PUBLIC_CONTACT_EMAIL=
